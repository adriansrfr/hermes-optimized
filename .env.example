# ============================================
# Hermes Agent — Secrets template
# ============================================
# Copy this file to .env and fill in your values.
# .env is gitignored by default.

# Model provider API keys
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# GOOGLE_API_KEY=...
# XAI_API_KEY=...
# MISTRAL_API_KEY=...
# GEMINI_API_KEY=...

# Optional: override model at runtime
HERMES_MODEL=anthropic/claude-sonnet-4
HERMES_PROVIDER=anthropic

# Gateway platform tokens (enable gateway first)
DISCORD_BOT_TOKEN=...
WHATSAPP_API_KEY=...
TELEGRAM_BOT_TOKEN=...
SLACK_BOT_TOKEN=...

# Optional: Firecrawl API key (if using Firecrawl web backend)
FIRECRAWL_API_KEY=...
